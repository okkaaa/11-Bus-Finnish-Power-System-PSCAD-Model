            <value><![CDATA[0.0017]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Coupling Resistance" name="Rc_in" group="Physical Setpoint" unit="pu" min="0" max="100" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.003]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Filter Capacitor" name="Cf_in" group="Physical Setpoint" unit="pu" min="0" max="10000" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[2.55]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Filter Capacitor Resistance" name="Rf2_in" group="Physical Setpoint" unit="pu" min="0" max="100" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.0005]]></value>
            <cond />
            <help />
          </parameter>
        </category>
        <category name="Filter Parameters" visible="true">
          <cond />
          <parameter desc="Phase-Locked Loop Filter" name="Wc_pll" group="" unit="rad/s" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[500]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Power Measurement Filter" name="Wc_s_meas" group="" unit="rad/s" min="0" max="1000" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[50]]></value>
            <cond />
            <help />
          </parameter>
        </category>
