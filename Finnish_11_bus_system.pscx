    <Definition classid="UserCmpDefn" name="GFL_Inverter_Dev1_6_2_1" group="" url="" version="" build="" crc="73446011" instances="0" key="" view="false" date="1791997325" id="1000144426">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Name" name="Name" group="" type="Text" helpmode="Append" allowemptystr="True">
            <value />
            <cond />
            <help />
            <regex />
            <error_msg />
          </parameter>
          <parameter desc="Base Frequency" name="f_base" group="" unit="Hz" min="0" max="100" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[60]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Base Power" name="s_base" group="" unit="kVA" min="0" max="900000" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Base Voltage" name="v_base" group="" unit="kV" min="0" max="1000" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.20785]]></value>
            <cond />
            <help><![CDATA[L-L voltage of inverter]]></help>
          </parameter>
          <parameter desc="Power Calculation Voltage" name="p_calc_volt" group="General" type="Choice" helpmode="Append">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
            <choice><![CDATA[0 = Capacitor Voltage]]></choice>
            <choice><![CDATA[1 = Grid Voltage]]></choice>
          </parameter>
          <parameter desc="Power Priority" name="Priority" group="" type="Choice" helpmode="Append">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
            <choice><![CDATA[0 = Reactive Power]]></choice>
            <choice><![CDATA[1 = Real power]]></choice>
          </parameter>
          <parameter desc="Grid Support Release" name="support_time" group="General" unit="s" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[10]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Current Limiting Time" name="cur_limit_time" group="Limiting" unit="s" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[10]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Ride Through Active" name="RT_activate" group="General" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
            <choice><![CDATA[0 = Inactive]]></choice>
            <choice><![CDATA[1 = Active]]></choice>
          </parameter>
          <parameter desc="Set Point Current Limiting" name="sp_cur_limit" group="Limiting" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond />
            <help><![CDATA[Enforces dispatch power limiting on current limiting, constructed on Q axis current]]></help>
            <choice><![CDATA[0 = Disabled]]></choice>
            <choice><![CDATA[1 = Enabled]]></choice>
          </parameter>
          <parameter desc="Anti Windup Technique" name="anti_windup_method" group="Limiting" type="Choice" helpmode="Append">
            <value><![CDATA[0]]></value>
            <cond />
            <help />
            <choice><![CDATA[0 = None]]></choice>
            <choice><![CDATA[1 = Conditional Integration]]></choice>
            <choice><![CDATA[2 = Back Calculation]]></choice>
          </parameter>
          <parameter desc="Current Limit Scale Factor" name="cur_scale_limit" group="Limiting" unit="pu" min="0" max="2.0" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1.1]]></value>
            <cond />
            <help><![CDATA[Scaling of current limit from base current]]></help>
          </parameter>
          <parameter desc="Positive Q Limit" name="Pos_Q_Rating" group="Limiting" unit="pu" min="0" max="1" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1.0]]></value>
            <cond />
            <help><![CDATA[pu of rating]]></help>
          </parameter>
          <parameter desc="Negative Q Limit" name="Neg_Q_Rating" group="Limiting" unit="pu" min="-1" max="0" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[-1.0]]></value>
            <cond />
            <help><![CDATA[pu of machine rating]]></help>
          </parameter>
          <parameter desc="Positive P Limit" name="Pos_P_Rating" group="Limiting" unit="pu" min="0" max="1" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[1.0]]></value>
            <cond />
            <help><![CDATA[pu of rating]]></help>
          </parameter>
          <parameter desc="Negative P Limit" name="Neg_P_Rating" group="Limiting" unit="pu" min="-1" max="0" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[-1.0]]></value>
            <cond />
            <help><![CDATA[Per unit of negative power capability]]></help>
          </parameter>
          <parameter desc="Ride Through Release" name="RT_release_time" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[100]]></value>
            <cond />
            <help><![CDATA[Time for ride through criteria to be engaged.]]></help>
          </parameter>
        </category>
        <category name="Passive Components" visible="true">
          <cond />
          <parameter desc="Filter Inductor" name="Lf_in" group="Physical Setpoint" unit="pu" min="0" max="100" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value><![CDATA[0.009]]></value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Filter Capacitor Engage" name="filter_cap_engage" group="Physical Setpoint" type="Choice" helpmode="Append">
            <value><![CDATA[1]]></value>
            <cond />
            <help />
            <choice><![CDATA[0 = Engage]]></choice>
            <choice><![CDATA[1 = Disengage]]></choice>
          </parameter>
